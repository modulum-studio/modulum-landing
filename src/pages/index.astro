---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modulum Studio – Coming Soon</title>
  </head>
  <body
    class="bg-slate-950 text-white font-sans flex flex-col items-center justify-center min-h-screen px-4 text-center"
  >
    <div class="max-w-2xl w-full">
      <h1
        class="text-3xl md:text-5xl font-semibold tracking-tight mb-6 leading-tight"
      >
        Modulum Studio is under construction
      </h1>
      <p class="text-gray-400 text-base md:text-lg mb-8 leading-relaxed">
        We're currently working on something exciting. This site is still being
        crafted, but you can reach out if you need us.
      </p>
      <a
        href="mailto:info@modulumstudio.com"
        class="inline-block border border-white text-white px-5 py-2 rounded-md hover:bg-white hover:text-slate-950 transition duration-300"
      >
        Contact us
      </a>
    </div>
  </body>
</html>
