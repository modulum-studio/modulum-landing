---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KompKit – Cross-Platform Utility Library</title>
    <meta
      name="description"
      content="Cross-platform utility library with conceptual API parity for TypeScript, Kotlin, and Dart."
    />
  </head>
  <body class="bg-slate-950 text-white font-sans min-h-screen">
    <!-- Header -->
    <header class="border-b border-slate-800 px-4 py-6">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a
          href="/"
          class="text-xl font-semibold hover:text-gray-300 transition-colors"
        >
          Modulum Studio
        </a>
        <div class="flex items-center space-x-6">
          <span
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-orange-500/20 text-orange-300 border border-orange-500/30"
          >
            v0.4.0-alpha.0
          </span>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="px-4 py-24 md:py-40">
      <div class="max-w-5xl mx-auto text-center">
        <div class="mb-8">
          <h1
            class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight mb-6"
          >
            <span class="text-white">Komp</span><span class="text-blue-400"
              >Kit</span
            >
          </h1>
          <div
            class="w-24 h-1 bg-gradient-to-r from-blue-400 to-purple-500 mx-auto mb-8"
          >
          </div>
        </div>

        <p
          class="text-xl md:text-3xl text-gray-300 mb-6 max-w-3xl mx-auto font-light"
        >
          Cross-platform utility library
        </p>
        <p class="text-lg md:text-xl text-gray-400 mb-16 max-w-2xl mx-auto">
          Same functions, same behavior, adapted to each platform's conventions
        </p>

        <div class="flex flex-wrap justify-center gap-6 mb-12">
          <div
            class="group px-6 py-3 bg-gradient-to-r from-blue-500/10 to-blue-600/10 rounded-xl border border-blue-500/20 hover:border-blue-400/40 transition-all"
          >
            <span class="text-blue-300 font-medium">TypeScript</span>
          </div>
          <div
            class="group px-6 py-3 bg-gradient-to-r from-purple-500/10 to-purple-600/10 rounded-xl border border-purple-500/20 hover:border-purple-400/40 transition-all"
          >
            <span class="text-purple-300 font-medium">Kotlin</span>
          </div>
          <div
            class="group px-6 py-3 bg-gradient-to-r from-cyan-500/10 to-cyan-600/10 rounded-xl border border-cyan-500/20 hover:border-cyan-400/40 transition-all"
          >
            <span class="text-cyan-300 font-medium">Dart</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Conceptual API Parity Section -->
    <section class="px-4 py-20 bg-slate-900/30">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-8">
          Conceptual API Parity
        </h2>
        <p class="text-lg text-gray-300 mb-16 max-w-2xl mx-auto">
          Same concepts, same function names, adapted to each platform's
          conventions
        </p>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div
              class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-blue-400 text-xl">≡</span>
            </div>
            <h3 class="font-semibold mb-2">Same Names</h3>
            <p class="text-sm text-gray-400">
              Identical function names across platforms
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-green-400 text-xl">⚡</span>
            </div>
            <h3 class="font-semibold mb-2">Same Behavior</h3>
            <p class="text-sm text-gray-400">
              Consistent functionality and results
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-purple-400 text-xl">⚙</span>
            </div>
            <h3 class="font-semibold mb-2">Native Feel</h3>
            <p class="text-sm text-gray-400">Adapted to platform conventions</p>
          </div>

          <div class="text-center">
            <div
              class="w-12 h-12 bg-orange-500/20 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-orange-400 text-xl">🔄</span>
            </div>
            <h3 class="font-semibold mb-2">Easy Switch</h3>
            <p class="text-sm text-gray-400">
              Minimal learning curve between platforms
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Utilities Section -->
    <section class="px-4 py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Utilities</h2>
          <p class="text-lg text-gray-400">
            Five functions. All platforms. Same behavior.
          </p>
        </div>

        <div class="space-y-3">
          <!-- debounce -->
          <div
            class="group flex items-center gap-6 px-6 py-5 bg-slate-800/40 rounded-xl border border-slate-700/40 hover:border-blue-500/40 hover:bg-slate-800/60 transition-all duration-200"
          >
            <div class="w-1 h-10 bg-blue-500 rounded-full flex-shrink-0"></div>
            <div class="w-40 flex-shrink-0">
              <code class="text-blue-300 font-mono font-semibold text-lg"
                >debounce</code
              >
            </div>
            <div class="flex-1 text-gray-300 text-sm leading-relaxed">
              Delays execution until after a wait period — prevents excessive
              calls on fast inputs
            </div>
            <div class="hidden md:flex items-center gap-3 flex-shrink-0">
              <span
                class="px-2 py-0.5 bg-blue-500/10 text-blue-400 text-xs rounded border border-blue-500/20 font-mono"
                >cancel()</span
              >
            </div>
          </div>

          <!-- isEmail -->
          <div
            class="group flex items-center gap-6 px-6 py-5 bg-slate-800/40 rounded-xl border border-slate-700/40 hover:border-green-500/40 hover:bg-slate-800/60 transition-all duration-200"
          >
            <div class="w-1 h-10 bg-green-500 rounded-full flex-shrink-0"></div>
            <div class="w-40 flex-shrink-0">
              <code class="text-green-300 font-mono font-semibold text-lg"
                >isEmail</code
              >
            </div>
            <div class="flex-1 text-gray-300 text-sm leading-relaxed">
              Validates email addresses using RFC-compliant regex — handles edge
              cases across all platforms
            </div>
            <div class="hidden md:flex items-center gap-3 flex-shrink-0">
              <span
                class="px-2 py-0.5 bg-green-500/10 text-green-400 text-xs rounded border border-green-500/20 font-mono"
                >→ boolean</span
              >
            </div>
          </div>

          <!-- formatCurrency -->
          <div
            class="group flex items-center gap-6 px-6 py-5 bg-slate-800/40 rounded-xl border border-slate-700/40 hover:border-purple-500/40 hover:bg-slate-800/60 transition-all duration-200"
          >
            <div class="w-1 h-10 bg-purple-500 rounded-full flex-shrink-0">
            </div>
            <div class="w-40 flex-shrink-0">
              <code class="text-purple-300 font-mono font-semibold text-lg"
                >formatCurrency</code
              >
            </div>
            <div class="flex-1 text-gray-300 text-sm leading-relaxed">
              Formats a number as currency with full locale support — defaults
              to en-US / USD
            </div>
            <div class="hidden md:flex items-center gap-3 flex-shrink-0">
              <span
                class="px-2 py-0.5 bg-purple-500/10 text-purple-400 text-xs rounded border border-purple-500/20 font-mono"
                >→ string</span
              >
            </div>
          </div>

          <!-- clamp -->
          <div
            class="group flex items-center gap-6 px-6 py-5 bg-slate-800/40 rounded-xl border border-slate-700/40 hover:border-orange-500/40 hover:bg-slate-800/60 transition-all duration-200"
          >
            <div class="w-1 h-10 bg-orange-500 rounded-full flex-shrink-0">
            </div>
            <div class="w-40 flex-shrink-0">
              <code class="text-orange-300 font-mono font-semibold text-lg"
                >clamp</code
              >
            </div>
            <div class="flex-1 text-gray-300 text-sm leading-relaxed">
              Constrains a number within an inclusive [min, max] range — safe
              and predictable
            </div>
            <div class="hidden md:flex items-center gap-3 flex-shrink-0">
              <span
                class="px-2 py-0.5 bg-orange-500/10 text-orange-400 text-xs rounded border border-orange-500/20 font-mono"
                >→ number</span
              >
            </div>
          </div>

          <!-- throttle -->
          <div
            class="group flex items-center gap-6 px-6 py-5 bg-slate-800/40 rounded-xl border border-slate-700/40 hover:border-red-500/40 hover:bg-slate-800/60 transition-all duration-200"
          >
            <div class="w-1 h-10 bg-red-500 rounded-full flex-shrink-0"></div>
            <div class="w-40 flex-shrink-0">
              <code class="text-red-300 font-mono font-semibold text-lg"
                >throttle</code
              >
            </div>
            <div class="flex-1 text-gray-300 text-sm leading-relaxed">
              Limits execution to at most once per wait period — ideal for
              scroll and resize handlers
            </div>
            <div class="hidden md:flex items-center gap-3 flex-shrink-0">
              <span
                class="px-2 py-0.5 bg-red-500/10 text-red-400 text-xs rounded border border-red-500/20 font-mono"
                >cancel()</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation Section -->
    <section class="px-4 py-20 bg-slate-900/30">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Get Started</h2>
          <p class="text-lg text-gray-400">
            Choose your platform and start building
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Web/TypeScript -->
          <div
            class="bg-gradient-to-br from-slate-800/50 to-slate-800/30 rounded-2xl p-8 border border-slate-700/50 hover:border-blue-500/30 transition-all"
          >
            <div class="flex items-center justify-between mb-6">
              <div
                class="w-16 h-16 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center"
              >
                <span class="text-blue-400 text-2xl font-bold">TS</span>
              </div>
              <span
                class="px-3 py-1 bg-green-500/20 text-green-300 text-xs font-medium rounded-full border border-green-500/30"
                >✓ Published</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-2">Web</h3>
            <p class="text-gray-400 mb-6">TypeScript / JavaScript</p>
            <div class="bg-slate-900/50 rounded-lg p-4 mb-6">
              <code class="text-green-400 text-sm font-mono"
                >npm install kompkit-core</code
              >
            </div>
            <a
              href="https://www.npmjs.com/package/kompkit-core"
              target="_blank"
              class="inline-flex items-center text-blue-400 hover:text-blue-300 transition-colors text-sm font-medium"
            >
              View on npm
              <svg
                class="ml-1 w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path></svg
              >
            </a>
          </div>

          <!-- Flutter/Dart -->
          <div
            class="bg-gradient-to-br from-slate-800/50 to-slate-800/30 rounded-2xl p-8 border border-slate-700/50 hover:border-cyan-500/30 transition-all"
          >
            <div class="flex items-center justify-between mb-6">
              <div
                class="w-16 h-16 bg-gradient-to-br from-cyan-500/20 to-cyan-600/20 rounded-xl flex items-center justify-center"
              >
                <span class="text-cyan-400 text-2xl font-bold">DT</span>
              </div>
              <span
                class="px-3 py-1 bg-green-500/20 text-green-300 text-xs font-medium rounded-full border border-green-500/30"
                >✓ Published</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-2">Flutter</h3>
            <p class="text-gray-400 mb-6">Dart</p>
            <div class="bg-slate-900/50 rounded-lg p-4 mb-6">
              <code class="text-green-400 text-sm font-mono"
                >flutter pub add kompkit_core:^0.4.0-alpha.0</code
              >
            </div>
            <a
              href="https://pub.dev/packages/kompkit_core"
              target="_blank"
              class="inline-flex items-center text-cyan-400 hover:text-cyan-300 transition-colors text-sm font-medium"
            >
              View on pub.dev
              <svg
                class="ml-1 w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path></svg
              >
            </a>
          </div>

          <!-- Android/Kotlin -->
          <div
            class="bg-gradient-to-br from-slate-800/50 to-slate-800/30 rounded-2xl p-8 border border-slate-700/50 hover:border-purple-500/30 transition-all"
          >
            <div class="flex items-center justify-between mb-6">
              <div
                class="w-16 h-16 bg-gradient-to-br from-purple-500/20 to-purple-600/20 rounded-xl flex items-center justify-center"
              >
                <span class="text-purple-400 text-2xl font-bold">KT</span>
              </div>
              <span
                class="px-3 py-1 bg-orange-500/20 text-orange-300 text-xs font-medium rounded-full border border-orange-500/30"
                >🚧 Local Only</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-2">Android</h3>
            <p class="text-gray-400 mb-6">Kotlin / JVM</p>
            <div class="bg-slate-900/50 rounded-lg p-4 mb-4">
              <code class="text-gray-400 text-xs font-mono"
                >// Local project reference</code
              >
            </div>
            <p class="text-gray-500 text-sm">
              Maven Central publishing coming soon
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Alpha Status Section -->
    <section
      class="px-4 py-24 bg-gradient-to-br from-slate-900/50 to-slate-800/30"
    >
      <div class="max-w-5xl mx-auto text-center">
        <div
          class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-orange-500/20 to-red-500/20 text-orange-300 rounded-2xl border border-orange-500/30 mb-12"
        >
          <span class="w-3 h-3 bg-orange-400 rounded-full mr-4 animate-pulse"
          ></span>
          <span class="font-semibold">Alpha Release - v0.4.0-alpha.0</span>
        </div>

        <h2
          class="text-4xl md:text-5xl font-bold mb-8 bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent"
        >
          Early Development
        </h2>
        <p
          class="text-xl text-gray-300 mb-16 max-w-3xl mx-auto leading-relaxed"
        >
          KompKit is in active alpha development. APIs may change before stable
          release. We encourage experimentation and feedback from the developer
          community.
        </p>

        <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto">
          <a
            href="https://github.com/Kompkit/KompKit"
            target="_blank"
            class="group flex items-center justify-center px-8 py-4 bg-gradient-to-r from-slate-800 to-slate-700 text-white rounded-xl border border-slate-600 hover:border-slate-500 hover:shadow-lg transition-all"
          >
            <svg
              class="mr-3 w-6 h-6 group-hover:scale-110 transition-transform"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="font-semibold">View Source</span>
          </a>
          <a
            href="https://github.com/Kompkit/KompKit/discussions"
            target="_blank"
            class="group flex items-center justify-center px-8 py-4 border-2 border-white text-white rounded-xl hover:bg-white hover:text-slate-950 transition-all"
          >
            <svg
              class="mr-3 w-6 h-6 group-hover:scale-110 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            <span class="font-semibold">Share Feedback</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Road Ahead Section -->
    <section class="px-4 py-20 bg-slate-900/30">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-8">Road Ahead</h2>
        <p class="text-lg text-gray-300 mb-12 max-w-2xl mx-auto">
          Building toward a comprehensive cross-platform utility ecosystem
        </p>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-blue-500/20 rounded-xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-blue-400 text-2xl">📚</span>
            </div>
            <h3 class="text-xl font-semibold mb-2">More Utilities</h3>
            <p class="text-gray-400 text-sm">
              Expanding the core utility collection
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-500/20 rounded-xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-green-400 text-2xl">🔧</span>
            </div>
            <h3 class="text-xl font-semibold mb-2">API Stability</h3>
            <p class="text-gray-400 text-sm">
              Moving toward stable 1.0 release
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-purple-500/20 rounded-xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-purple-400 text-2xl">🌐</span>
            </div>
            <h3 class="text-xl font-semibold mb-2">Platform Coverage</h3>
            <p class="text-gray-400 text-sm">
              Ensuring comprehensive platform support
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-slate-800 px-4 py-12">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="mb-6 md:mb-0">
            <p class="text-gray-400 text-sm">
              <strong>Alpha Notice:</strong> APIs may change before stable release.
              Pin to specific versions in production.
            </p>
          </div>
          <div class="flex space-x-6 text-sm">
            <a href="/" class="text-gray-400 hover:text-white transition-colors"
              >Home</a
            >
            <a
              href="/privacy"
              class="text-gray-400 hover:text-white transition-colors"
              >Privacy</a
            >
            <a
              href="https://github.com/Kompkit/KompKit/blob/main/LICENSE"
              target="_blank"
              class="text-gray-400 hover:text-white transition-colors"
              >MIT License</a
            >
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
